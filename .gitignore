# Corpus data is downloaded at setup time, never committed
corpus/*.json
# Model binaries are downloaded at setup time, never committed
models/*.gguf
# Local database backups (derived data, restorable via pg_restore)
backups/
# Container data (bind mounts): postgres data + ollama models.
# Lives here so it survives VM replacement; never committed.
data/
# Local secrets
.env
__pycache__/
*.pyc
